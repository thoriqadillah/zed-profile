// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "status_bar": {
    "show_active_file": false
  },
  "file_finder": {
    "modal_max_width": "medium"
  },
  "diff_view_style": "split",
  "minimap": {
    "show": "never"
  },
  "text_rendering_mode": "platform_default",
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "dock": "left"
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "auto_update_extensions": {
    "vue": false,
    "proto": false
  },
  "sticky_scroll": {
    "enabled": true
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "preview_tabs": {
    "enable_preview_from_project_panel": true
  },
  "git_panel": {
    "show_count_badge": true,
    "fallback_branch_name": "master",
    "dock": "left",
    "file_icons": true,
    "status_style": "label_color",
    "tree_view": false,
    "sort_by_path": false
  },
  "colorize_brackets": true,
  "extend_comment_on_newline": false,
  "show_edit_predictions": true,
  "git": {
    "hunk_style": "staged_hollow",
    "inline_blame": {
      "padding": 7,
      "show_commit_summary": true
    }
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false
  },
  "buffer_line_height": {
    "custom": 1.6180000305175781
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },
  "tabs": {
    "show_diagnostics": "all",
    "git_status": true,
    "file_icons": true
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_branch_status_icon": true
  },
  "buffer_font_family": "JetBrains Mono",
  "terminal": {
    "show_count_badge": false,
    "toolbar": {
      "breadcrumbs": false
    }
  },
  "tab_size": 4,
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "default": "allow"
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6"
    },
    "play_sound_when_agent_done": "always",
    "model_parameters": []
  },
  "outline_panel": {
    "dock": "left",
    "git_status": true,
    "indent_size": 14.0
  },
  "project_panel": {
    "bold_folder_labels": false,
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "dock": "left",
    "indent_size": 14.0
  },
  "languages": {
    "Python": {
      "language_servers": ["ty"]
    },
    "Proto": {
      "format_on_save": "off",
      "language_servers": ["protobuf-language-server"]
    },
    "YAML": {
      "format_on_save": "off",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Vue.js": {
      "language_servers": ["vtsls", "vue-language-server"]
    },
    "JSONC": {
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  },
  "lsp": {
    "protobuf-language-server": {
      "binary": {
        "path": "/home/thoriqadillah/.cargo/bin/protobuf-lsp"
      }
    }
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "git_commit_buffer_font_size": 12,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dracula"
  }
}
